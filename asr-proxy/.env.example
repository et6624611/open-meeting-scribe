# ============================================================
# ASR 代理服务 — 环境变量配置
# 部署位置：你的云服务器 IP
# 注意：此文件包含 DashScope API Key，严禁入库！
# ============================================================

# ── 共享密钥（与客户端 ASR_PROXY_TOKEN 一致）──
# 用于校验客户端请求签名，防未授权调用
ASR_PROXY_TOKEN=your-shared-secret-here

# ── 签名有效期（秒），防重放 ──
ASR_SIGN_TTL=300

# ── DashScope API Key（平台 Key，仅服务端持有）──
# 获取：https://bailian.console.aliyun.com/ → API-KEY
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
