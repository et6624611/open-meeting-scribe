# ============================================================
# Open Meeting Scribe — 环境变量模板
# 用法：cp .env.example .env，填入真实值。.env 已在 .gitignore，严禁入库。
# ============================================================

# 阿里云百炼 DashScope API Key
# 一个 key 同时用于「录音文件识别(ASR+说话人分离)」和「通义千问(纪要生成)」
# 获取：https://bailian.console.aliyun.com/ → API-KEY
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 可选：模型选型 ----
ASR_MODEL=paraformer-v2
LLM_MODEL=qwen-plus

# ---- 可选：端点覆盖 ----
# 默认公共端点即可；如用华北2(北京)业务空间专属域名再覆盖
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ---- 可选：转写参数 ----
# 说话人分离（默认开）；语言提示
DIARIZATION_ENABLED=true
LANGUAGE_HINTS=zh,en

# ── GitHub OAuth ──
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ── 短信代理（云端代理模式，AccessKey 不落地）──
# 短信服务走云端代理，阿里云密钥由代理服务器持有，客户端不存储
# SMS_PROXY_URL 为代理地址，SMS_PROXY_TOKEN 为共享密钥（防未授权调用）
SMS_PROXY_URL=http://47.116.10.194:8080
SMS_PROXY_TOKEN=

# ── JWT 配置 ──
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# ── 管理后台 ──
# 管理后台独立运行在 8001 端口（python cli.py admin）
# 密码用于登录管理后台，请设置一个强密码
ADMIN_PASSWORD=***REDACTED***
# ── 应用配置 ──
APP_URL=http://localhost:8000
