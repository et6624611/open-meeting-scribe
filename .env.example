# ============================================================
# Open Meeting Scribe — 环境变量模板
# 用法：cp .env.example .env，填入真实值。.env 已在 .gitignore，严禁入库。
# ============================================================

# 阿里云百炼 DashScope API Key
# 一个 key 同时用于「录音文件识别(ASR+说话人分离)」和「通义千问(纪要生成)」
# 获取：https://bailian.console.aliyun.com/ → API-KEY
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 可选：模型选型 ----
ASR_MODEL=paraformer-v2
LLM_MODEL=qwen-plus

# ---- 可选：端点覆盖 ----
# 默认公共端点即可；如用华北2(北京)业务空间专属域名再覆盖
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ---- 可选：转写参数 ----
# 说话人分离（默认开）；语言提示
DIARIZATION_ENABLED=true
LANGUAGE_HINTS=zh,en

# ── GitHub OAuth ──
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ── 阿里云短信认证服务 (PNVS) ──
# 获取：https://ram.console.aliyun.com/profile/access-keys
# 签名和模板 Code 在号码认证服务控制台查看：https://dypns.console.aliyun.com/smsServiceOverview
# 注意：PNVS 现已不支持自定义签名，须用控制台「赠送签名+赠送模板」（示例值 恒创联众/100001）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=恒创联众
SMS_TEMPLATE_CODE=100001
# 模板参数（必填）：缺失报 MissingTemplateParam；变量名/个数须与模板内容完全一致，否则报「模板内容与模板参数不匹配」。
# 赠送模板 100001 含 ${code} 和 ${min} 两个变量：code 用占位符 ##code## 由 PNVS 生成托管，min 为有效期分钟数（与 5 分钟一致）。
SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}
# 验证码规则：CodeType 1=纯数字（传 ##code## 占位符时必填）；CodeLength 4~8 位
SMS_CODE_TYPE=1
SMS_CODE_LENGTH=6

# ── JWT 配置 ──
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# ── 管理后台 ──
# 管理后台独立运行在 8001 端口（python cli.py admin）
# 密码用于登录管理后台，请设置一个强密码
ADMIN_PASSWORD=***REDACTED***
# ── 应用配置 ──
APP_URL=http://localhost:8000
