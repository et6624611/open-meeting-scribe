# ============================================================
# Open Meeting Scribe — 环境变量模板
# 用法：cp .env.example .env，填入真实值。.env 已在 .gitignore，严禁入库。
# ============================================================

# ── ASR 转写模式 ──
# cloud（桌面客户端默认）：通过云端服务器代理，用户零配置，登录即用
# proxy（Web 服务器默认）：通过 ASR 代理服务器中转，客户端不存储 DashScope API Key
# direct：客户端直连 DashScope API，需要下方 DASHSCOPE_API_KEY
# 桌面客户端（exe）自动设置为 cloud；Web 服务器建议使用 proxy 模式
# ASR_MODE=cloud

# ── ASR 代理（云端代理模式，DashScope Key 不落地）──
# 转写请求通过代理服务器中转，客户端不存储 DashScope API Key
# 详见 docs/adr/0012-ASR转写走云端代理.md
ASR_PROXY_URL=http://your-asr-proxy-host:8200
ASR_PROXY_TOKEN=

# ── DashScope API Key（仅用于 LLM 纪要生成）──
# ASR 已走代理，此 Key 仅用于通义千问纪要生成
# 获取：https://bailian.console.aliyun.com/ → API-KEY
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 可选：模型选型 ----
ASR_MODEL=paraformer-v2
LLM_MODEL=qwen-plus

# ---- 可选：端点覆盖 ----
# 默认公共端点即可；如用华北2(北京)业务空间专属域名再覆盖
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ---- 可选：转写参数 ----
# 说话人分离（默认开）；语言提示
DIARIZATION_ENABLED=true
LANGUAGE_HINTS=zh,en

# ── GitHub OAuth ──
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ── 短信代理（云端代理模式，AccessKey 不落地）──
# 短信服务走云端代理，阿里云密钥由代理服务器持有，客户端不存储
# SMS_PROXY_URL 为代理地址，SMS_PROXY_TOKEN 为共享密钥（防未授权调用）
#
# ⚠️ 重要：桌面客户端必须配置以下两项才能使用手机号登录功能：
#   1. SMS_PROXY_URL — 指向您部署的 sms-proxy 服务地址
#      示例：https://sms.yourdomain.com 或 http://your-server:8080
#   2. SMS_PROXY_TOKEN — 与 sms-proxy 服务端 .env 中相同的共享密钥
#      生成方式：openssl rand -hex 32
#
# 未配置时，登录页面将显示「未配置 SMS_PROXY_TOKEN，无法调用短信代理」
# 详见：sms-proxy/README.md 和 docs/DEPLOYMENT.md
SMS_PROXY_URL=http://your-sms-proxy-host:8080
SMS_PROXY_TOKEN=

# ── 云端用户服务（桌面客户端连接云端用）──
# 桌面客户端（Mac/Windows）将 SMS 登录用户同步、用量上报、配额查询发送到云端服务器，
# 使管理后台可见所有桌面端用户并统一管控配额。未配置时桌面端完全本地运行（与旧版行为一致）。
# CLOUD_API_TOKEN 为 HMAC 共享密钥，须与服务器端 CLOUD_API_TOKEN 一致
CLOUD_API_URL=http://your-server:8000
CLOUD_API_TOKEN=

# ── JWT 配置 ──
# 生产/多用户部署必须设置固定的强密钥（建议 openssl rand -base64 32 生成）。
# 留空时服务会生成进程级临时随机密钥，重启后所有登录会话失效，仅适用于本地开发。
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# ── 认证强制开关 ──
# 多用户/服务器部署（如 0.0.0.0 对外）时必须设为 true，强制所有业务 API 校验登录会话；
# 本地个人使用（127.0.0.1）保持 false，免登录直接使用。
REQUIRE_AUTH=false

# ── 管理后台 ──
# 管理后台独立运行在 8001 端口（python cli.py admin），仅绑定本地回环，不对外暴露
# 密码用于登录管理后台，必须设置强密码（≥ 8 位）；
# 服务会拒绝下方占位符及 admin/password/123456 等弱口令，请登录前改为真实强密码。
ADMIN_PASSWORD=
# ── 应用配置 ──
APP_URL=http://localhost:8000

# ── Cookie 安全 ──
# 生产环境 HTTPS 部署时设为 true，本地开发保持 false
COOKIE_SECURE=false

# ── CORS 跨域 ──
# 允许跨域请求的来源列表（逗号分隔）。未配置时默认允许 localhost 各端口（开发模式）。
# 生产部署时请设置为前端实际域名，例如：https://meet.example.com
# CORS_ORIGINS=https://meet.example.com,https://admin.example.com
