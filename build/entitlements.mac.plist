<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  build/entitlements.mac.plist — Developer ID + hardened runtime 签名授权（WP-G G-7）

  PyInstaller 冻结应用（内嵌 CPython JIT-less 解释器 + 动态加载扩展）在
  hardened runtime 下需要的最小授权集：
    - allow-unsigned-executable-memory：CPython/ctypes 动态生成可执行页
    - allow-dyld-environment-variables：桌面端 .env/环境注入调试路径
    - disable-library-validation：加载未以同一 Team ID 签名的第三方 dylib
      （ffmpeg/ffprobe 下载件；若后续对 ffmpeg 一并签名可移除此项收紧）
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
