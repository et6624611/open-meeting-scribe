# ============================================================
# 桌面端云端服务凭据
#
# 用途：打包桌面应用时，将此文件复制为 desktop-secrets.env，
#       PyInstaller 会将其内嵌到 .app / .exe 中，供 desktop.py
#       启动时读取，作为 SMS 代理和云端用户服务的默认地址。
#
# 本地开发时：复制此文件并填入真实值，命名为 desktop-secrets.env
#             cp desktop-secrets.env.example desktop-secrets.env
#             # desktop-secrets.env 已在 .gitignore，不会入库
#
# CI 打包时：GitHub Actions 工作流自动从 GitHub Secrets 生成此文件
#            （见 .github/workflows/build-macos.yml / build-windows.yml）
#
# 对应 GitHub Secrets 名称：
#   OMS_CLOUD_API_URL / OMS_CLOUD_API_TOKEN
#   OMS_SMS_PROXY_URL / OMS_SMS_PROXY_TOKEN
# ============================================================

CLOUD_API_URL=http://your-cloud-server:8000
CLOUD_API_TOKEN=your-hmac-shared-secret

SMS_PROXY_URL=http://your-sms-proxy:8080
SMS_PROXY_TOKEN=your-hmac-shared-secret
