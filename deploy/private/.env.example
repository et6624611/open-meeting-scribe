# 企业版 P0 一键包配置。首次运行 oms-offline-install.sh 时自动生成本副本为 .env。
# 修改后重新执行 ./oms-offline-install.sh 使变更生效（幂等）。
OMS_VERSION=local
OMS_PORT=8000
OMS_ADMIN_PORT=8001

# 加密访问三态（产品裁决①：出厂 off，向导/管理台显著推荐一键开 internal-ca）
#   off          员工用 http://<服务器IP>:8000 访问（内网明文，文档已提示风险）
#   internal-ca  Caddy 本地根 CA 签发自托管证书，员工用 https://<服务器IP>:8443，
#                需每台终端导入一次 ca/oms-root-ca.crt
#   custom-cert  使用企业自有证书，把 fullchain.pem/privkey.pem 放入 proxy/certs/
OMS_TLS_MODE=off
OMS_TLS_PORT=8443

# 备份：自动保留 14 天（企业数据治理承诺口径，勿随意调小）
OMS_BACKUP_INTERVAL_SEC=86400
OMS_BACKUP_KEEP_DAYS=14

TZ=Asia/Shanghai

# 健康探活路径（默认 /healthz，后端契约端点）。
# 若所用版本尚未提供 /healthz，可临时设为 / 使探活先行通过。
OMS_HEALTH_PATH=/healthz
