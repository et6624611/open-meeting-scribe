# ============================================================
# SMS 代理服务 — 环境变量配置
# 部署位置：你的云服务器 IP
# 注意：此文件包含阿里云 AccessKey，严禁入库！
# ============================================================

# ── 共享密钥（与客户端 SMS_PROXY_TOKEN 一致）──
# 用于校验客户端请求签名，防未授权调用
SMS_PROXY_TOKEN=your-shared-secret-here

# ── 签名有效期（秒），防重放 ──
SMS_SIGN_TTL=300

# ── 阿里云 PNVS 配置 ──
# 获取：https://ram.console.aliyun.com/profile/access-keys
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# ── 短信模板配置 ──
# 签名和模板 Code 在号码认证服务控制台查看：https://dypns.console.aliyun.com/smsServiceOverview
SMS_SIGN_NAME=恒创联众
SMS_TEMPLATE_CODE=100001
SMS_EXPIRE_MINUTES=5

# 模板参数（JSON 字符串）：
# 赠送模板 100001 含 ${code} 和 ${min} 两个变量
# code 用占位符 ##code## 由 PNVS 生成托管，min 为有效期分钟数
SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}

# 验证码规则：CodeType 1=纯数字（传 ##code## 占位符时必填）；CodeLength 4~8 位
SMS_CODE_TYPE=1
SMS_CODE_LENGTH=6
