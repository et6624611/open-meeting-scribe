{
  "name": "open-meeting-scribe-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:parser": "node --experimental-strip-types scripts/test-parse-insight-flow.ts",
    "test:shortcuts": "node --experimental-strip-types --test scripts/test-date-shortcuts.mjs",
    "test:popover": "node --experimental-strip-types --test scripts/test-popover-position.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "eslint 'src/**/*.vue'",
    "lint:fix": "eslint 'src/**/*.vue' --fix"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "mermaid": "^12.0.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.4.0",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.42.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.0"
  }
}
